# Copy to .env for local dev:  cp .env.example .env
# SQLite (zero-infra local dev). To switch to Postgres later:
#   1) change provider in prisma/schema.prisma to "postgresql"
#   2) set DATABASE_URL="postgresql://user:password@localhost:5432/strings"
#   3) run: npx prisma migrate dev --name switch-to-postgres
DATABASE_URL="file:./dev.db"
PORT=4000
